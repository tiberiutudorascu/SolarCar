/* USER CODE BEGIN 4 */

void Send_MPPT_Telemetrie(void) {
    TxData[0] = (uint8_t)V_panou;
    TxData[1] = (uint8_t)(I_panou * 10.0f);
    TxData[2] = (uint8_t)(P_panou / 2.0f);
    TxData[3] = mppt_status_code;

    if (HAL_CAN_GetTxMailboxesFreeLevel(&hcan) > 0) {
        HAL_CAN_AddTxMessage(&hcan, &TxHeader, TxData, &TxMailbox);
    }
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM2) {
        // Calculează valorile reale din buffer-ul ADC
        V_panou = ((float)adc_buffer[0] * (3.3f / 4095.0f)) * V_DIVIDER_RATIO;
        I_panou = (((float)adc_buffer[1] * (3.3f / 4095.0f)) - I_OFFSET) / I_SENSITIVITY;
        P_panou = V_panou * I_panou;

        // Logica de protecție cu filtru de stabilitate
        static uint8_t error_count = 0;

        if (V_panou > V_MAX_CRITIC) {
            mppt_status_code = 1;
            pwm_value = PWM_MIN;
        }
        else if (I_panou > I_MAX_CRITIC) {
            error_count++;
            if (error_count > 5) { // Trebuie să persiste eroarea pentru declanșare
                mppt_status_code = 2;
                pwm_value = PWM_MIN;
            }
        }
        else {
        	mppt_status_code = 0; // resetam statusul la OK
            error_count = 0; // Resetăm filtrul dacă valorile sunt sigure

            if(P_panou < 0.1f) {
                pwm_value++;
            } else {
                // Algoritm P&O
                float deltaP = P_panou - P_veche;
                float deltaV = V_panou - V_veche;

                if (deltaP > 0.1f) {
                     if (deltaV > 0.0f) pwm_value--; else pwm_value++;
                } else if (deltaP < -0.1f) {
                     if (deltaV > 0.0f) pwm_value++; else pwm_value--;
                }
            }
        }

        // Limitare și aplicare PWM
        if (pwm_value < PWM_MIN) pwm_value = PWM_MIN;
        if (pwm_value > PWM_MAX) pwm_value = PWM_MAX;
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, pwm_value);

        V_veche = V_panou;
        P_veche = P_panou;

        // Trimitem telemetria la fiecare 100ms
        static uint8_t count = 0;
        if (++count >= 2) {
            Send_MPPT_Telemetrie();
            printf("\033[2J\033[H"); // Șterge ecranul și duce cursorul în colțul de sus
            printf("=== PIT STOP TELEMETRY ===\r\n");
            printf("PANEL VOLTAGE: %.2f V\r\n", V_panou);
            printf("PANEL CURRENT: %.2f A\r\n", I_panou);
            printf("TOTAL POWER:   %.2f W\r\n", P_panou);
            printf("STATUS CODE:   %d\r\n", mppt_status_code);
            printf("PWM DUTY:      %d\r\n", pwm_value);
            printf("==========================\r\n");
            count = 0;
        }
    }
}

int write(int file, char *ptr, int len){
	for(int i = 0; i < len; i++){
		ITM_SendChar((*ptr++));
	}
	return len;
}
