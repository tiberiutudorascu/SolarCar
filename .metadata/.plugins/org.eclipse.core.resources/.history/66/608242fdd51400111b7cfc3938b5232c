/* ============================================================
 * MAIN
 * ============================================================ */
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_DMA_Init();
    MX_ADC1_Init();
    MX_TIM1_Init();
    MX_TIM2_Init();
    MX_CAN_Init();
    MX_USART1_UART_Init();

    /* USER CODE BEGIN 2 */

    // 1. Filtru CAN
    CAN_FilterTypeDef sf = {0};
    sf.FilterBank           = 0;
    sf.FilterMode           = CAN_FILTERMODE_IDMASK;
    sf.FilterScale          = CAN_FILTERSCALE_32BIT;
    sf.FilterIdHigh         = 0x0000;
    sf.FilterIdLow          = 0x0000;
    sf.FilterMaskIdHigh     = 0x0000;
    sf.FilterMaskIdLow      = 0x0000;
    sf.FilterFIFOAssignment = CAN_RX_FIFO0;
    sf.FilterActivation     = ENABLE;
    HAL_CAN_ConfigFilter(&hcan, &sf);

    // 2. Pornire CAN — Start INAINTE de ActivateNotification (identic pedala)
    if (HAL_CAN_Start(&hcan) != HAL_OK) {
        Error_Handler();
    }
    HAL_CAN_ActivateNotification(&hcan, CAN_IT_RX_FIFO0_MSG_PENDING);

    // 3. ADC + DMA
    HAL_ADCEx_Calibration_Start(&hadc1);
    HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, 2);

    // 4. PWM
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, pwm_value);

    // 5. Timer 20ms
    HAL_TIM_Base_Start_IT(&htim2);

    // 6. Boot UART
    const char *boot = "\r\n=== MPPT BOOT OK ===\r\n";
    HAL_UART_Transmit(&huart1, (uint8_t*)boot, 24, 100);

    // Contoare timp — identic cu pedala
    uint8_t tick_100ms = 0;
    uint8_t tick_500ms = 0;

    /* USER CODE END 2 */

    /* ============================================================
     * WHILE(1) — structura identica cu pedala
     * ============================================================ */
    while (1)
    {
        if (timer_20ms_flag == 1) {

            // 1. Proceseaza MPPT (ADC + protectii + P&O + PWM)
            MPPT_Process();

            // 2. Incrementare contoare
            tick_100ms++;
            tick_500ms++;

            // --- 100ms: CAN 0x630 catre VCU ---
            if (tick_100ms >= 5) {
                MPPT_Pack_0x630(TxData);
                CAN_TX(0x630, 5, TxData);
                HAL_GPIO_TogglePin(LED_STARE_GPIO_Port, LED_STARE_Pin);
                tick_100ms = 0;
            }

            // --- 500ms: CAN 0x631 + UART catre PuTTY ---
            if (tick_500ms >= 25) {
                MPPT_Pack_0x631(TxData);
                CAN_TX(0x631, 4, TxData);

                int len = snprintf(uart_buf, sizeof(uart_buf),
                    "V:%.2f I:%.2f P:%.2f PWM:%d ST:%d\r\n",
                    V_panou, I_panou, P_panou,
                    pwm_value, mppt_status_code);
                HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, len, 10);

                tick_500ms = 0;
            }

            // 3. Reset flag
            timer_20ms_flag = 0;
        }
    }
}

