    txheader.RTR                = CAN_RTR_DATA;
    txheader.TransmitGlobalTime = DISABLE;
    if (HAL_CAN_AddTxMessage(&hcan, &txheader, Data, &txmailbox) != HAL_OK) {
        // Error_Handler(); // Comentat: previne blocarea daca VCU nu e inca pornit
    }
}

/**
 * @brief Proceseaza ADC, protectii si P&O
 */
static void MPPT_Process(void) {
    V_panou = ((float)adc_buffer[0] * (3.3f / 4095.0f)) * V_DIVIDER_RATIO;
    I_panou = (((float)adc_buffer[1] * (3.3f / 4095.0f)) - I_OFFSET) / I_SENSITIVITY;
    if (I_panou < 0.0f) I_panou = 0.0f;
    P_panou = V_panou * I_panou;

    static uint8_t error_count = 0;

    if (V_panou > V_MAX_CRITIC) {
        mppt_status_code = 1;
        pwm_value = PWM_MIN;
        error_count = 0;
    } else if (I_panou > I_MAX_CRITIC) {
        if (++error_count > 5) {
            mppt_status_code = 2;
            pwm_value = PWM_MIN;
        }
    } else {
        mppt_status_code = 0;
        error_count = 0;
        if (P_panou < 0.1f) {
            pwm_value++;
        } else {
            float deltaP = P_panou - P_veche;
            float deltaV = V_panou - V_veche;
            if      (deltaP >  0.1f) { if (deltaV >= 0.0f) pwm_value--; else pwm_value++; }
            else if (deltaP < -0.1f) { if (deltaV >= 0.0f) pwm_value++; else pwm_value--; }
        }
    }

    if (pwm_value < PWM_MIN) pwm_value = PWM_MIN;
    if (pwm_value > PWM_MAX) pwm_value = PWM_MAX;
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, pwm_value);

    V_veche = V_panou;
    P_veche = P_panou;
}

/**
 * @brief CAN 0x630 — date principale MPPT catre VCU (4 bytes)
 *   [0] = V * 10   (ex: 245 = 24.5V)
 *   [1] = I * 10   (ex:  85 =  8.5A)
 *   [2] = P / 2    (ex: 104 = 208W)
 *   [3] = status   (0=OK, 1=OV, 2=OC)
 */
static void MPPT_Pack_0x630(uint8_t *buf) {
	uint16_t v10 = (uint16_t)(V_panou * 10.0f);
	uint16_t i10 = (uint16_t)(I_panou * 10.0f);

	buf[0] = (uint8_t)(v10 >> 8);   // Tensiune High Byte
	buf[1] = (uint8_t)(v10 & 0xFF); // Tensiune Low Byte
	buf[2] = (uint8_t)(i10 >> 8);   // Curent High Byte
	buf[3] = (uint8_t)(i10 & 0xFF); // Curent Low Byte
	buf[4] = mppt_status_code;
}

/**
 * @brief CAN 0x631 — date extinse MPPT (4 bytes, rezolutie mai mare)
 *   [0-1] = V * 100 uint16 big-endian (ex: 2450 = 24.50V)
 *   [2-3] = I * 100 uint16 big-endian (ex:  850 =  8.50A)
 */
static void MPPT_Pack_0x631(uint8_t *buf) {
    uint16_t v100 = (uint16_t)(V_panou * 100.0f);
    uint16_t i100 = (uint16_t)(I_panou * 100.0f);
    buf[0] = (v100 >> 8) & 0xFF;
    buf[1] =  v100       & 0xFF;
    buf[2] = (i100 >> 8) & 0xFF;
    buf[3] =  i100       & 0xFF;
}

/**
 * @brief Callback Timer — identic cu pedala
 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM2) {
        timer_20ms_flag = 1;
    }
}

