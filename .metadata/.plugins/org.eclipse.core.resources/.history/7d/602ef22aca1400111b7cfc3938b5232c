/* CAN TX generic — exact structura ta, fara Error_Handler la esec TX
 * (daca mailbox-ul e plin, mesajul e ignorat in loc sa blocheze tot) */
void CAN_TX(uint32_t StdId, uint32_t DLC, const uint8_t *Data) {
	CAN_TxHeaderTypeDef txheader;
	uint32_t txmailbox;

	txheader.DLC   = DLC;
	txheader.StdId = StdId;
	txheader.IDE   = CAN_ID_STD;
	txheader.RTR   = CAN_RTR_DATA;
	txheader.TransmitGlobalTime = DISABLE;

	/* Verifica mailbox liber inainte — fara asta HAL_CAN_AddTxMessage
	 * returneaza eroare cand toate cele 3 mailbox-uri sunt ocupate */
	if (HAL_CAN_GetTxMailboxesFreeLevel(&hcan) > 0) {
		HAL_CAN_AddTxMessage(&hcan, &txheader, Data, &txmailbox);
	}
}

/* Trimite datele MPPT reale pe CAN (ID 0x630, catre VCU) */
void Send_MPPT_Telemetrie(void) {
	TxData[0] = (uint8_t)(V_panou * 10.0f > 255 ? 255 : V_panou * 10.0f); // V×10
	TxData[1] = (uint8_t)(I_panou < 0 ? 0 : I_panou * 10.0f);             // I×10
	TxData[2] = (uint8_t)(P_panou / 2.0f > 255 ? 255 : P_panou / 2.0f);   // P/2
	TxData[3] = mppt_status_code;                                           // status

	if (HAL_CAN_GetTxMailboxesFreeLevel(&hcan) > 0) {
		HAL_CAN_AddTxMessage(&hcan, &TxHeader, TxData, &TxMailbox);
	}
}

