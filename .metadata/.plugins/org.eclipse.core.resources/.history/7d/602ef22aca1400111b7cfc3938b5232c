int main(void)
{
	HAL_Init();
	SystemClock_Config();
	MX_GPIO_Init();
	MX_DMA_Init();
	MX_ADC1_Init();
	MX_TIM1_Init();
	MX_TIM2_Init();
	MX_CAN_Init();
	MX_USART1_UART_Init();

	/* USER CODE BEGIN 2 */

	/* ----------------------------------------------------------------
	 * UART primul — trimite mesaj de boot imediat
	 * Daca apare "BOOT OK" in PuTTY, stii ca UART merge.
	 * Daca NU apare, problema e hardware (cablu, port COM, flow control)
	 * ---------------------------------------------------------------- */
	const char *boot_msg = "\r\n=== MPPT BOOT OK ===\r\n";
	HAL_UART_Transmit(&huart1, (uint8_t*)boot_msg, 22, 100);

	/* ----------------------------------------------------------------
	 * CAN — pornire in ordinea corecta:
	 *   1. ConfigFilter  (obligatoriu inainte de Start)
	 *   2. HAL_CAN_Start
	 *   3. ActivateNotification  (DUPA Start, nu inainte!)
	 * ---------------------------------------------------------------- */
	CAN_FilterTypeDef sFilterConfig;
	sFilterConfig.FilterBank           = 0;
	sFilterConfig.FilterMode           = CAN_FILTERMODE_IDMASK;
	sFilterConfig.FilterScale          = CAN_FILTERSCALE_32BIT;
	sFilterConfig.FilterIdHigh         = 0x0000;
	sFilterConfig.FilterIdLow          = 0x0000;
	sFilterConfig.FilterMaskIdHigh     = 0x0000; // accepta toate ID-urile
	sFilterConfig.FilterMaskIdLow      = 0x0000;
	sFilterConfig.FilterFIFOAssignment = CAN_RX_FIFO0;
	sFilterConfig.FilterActivation     = ENABLE;
	HAL_CAN_ConfigFilter(&hcan, &sFilterConfig);

	HAL_CAN_Start(&hcan);
	HAL_CAN_ActivateNotification(&hcan, CAN_IT_RX_FIFO0_MSG_PENDING);

	/* Periferice */
	HAL_ADCEx_Calibration_Start(&hadc1);
	HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, 2);
	HAL_TIM_Base_Start_IT(&htim2);
	HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);

	/* Header CAN TX pentru telemetria MPPT */
	TxHeader.StdId              = 0x630;
	TxHeader.IDE                = CAN_ID_STD;
	TxHeader.RTR                = CAN_RTR_DATA;
	TxHeader.DLC                = 4;
	TxHeader.TransmitGlobalTime = DISABLE;

	/* USER CODE END 2 */

	/* ----------------------------------------------------------------
	 * WHILE(1)
	 * - UART trimite continuu (independent de CAN)
	 * - tim2_flag_b e setat de ISR-ul TIM2 la fiecare ~112ms
	 * - Cand flag e 1: toggle LED + trimite CAN + reseteaza flag
	 * ---------------------------------------------------------------- */
	while (1) {

		/* UART — trimite datele curente catre PuTTY
		 * Timeout 10ms (nu 100ms!) ca sa nu blocheze ISR-ul TIM2 */
		int len = sprintf(uart_buf,
			"V:%.2f I:%.2f P:%.2f PWM:%d ST:%d\r\n",
			V_panou, I_panou, P_panou, pwm_value, mppt_status_code);
		HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, len, 10);

		/* CAN TX + LED — exact structura ta, o data per flag */
		if (tim2_flag_b == 1) {

			HAL_GPIO_TogglePin(LED_STARE_GPIO_Port, LED_STARE_Pin);

			/* Trimite datele MPPT reale pe 0x630 catre VCU */
			Send_MPPT_Telemetrie();

			/* Trimite broadcast pe 0x100 catre alte noduri
			 * (datele hardcodate din snippetul tau, le poti inlocui cu date reale) */
			uint8_t Data_100[8] = {
				(uint8_t)(V_panou * 10.0f > 255 ? 255 : V_panou * 10.0f),
				(uint8_t)(I_panou < 0 ? 0 : I_panou * 10.0f),
				(uint8_t)(P_panou / 2.0f > 255 ? 255 : P_panou / 2.0f),
				mppt_status_code,
				(uint8_t)(pwm_value * 100 / PWM_MAX), // duty cycle 0-100%
				0x00,
				0x00,
				0x00
			};
			CAN_TX(0x100, 8, Data_100);

			tim2_flag_b = 0;
		}
	}
}

/* ====================================================================
 * CALLBACKS
 * ==================================================================== */

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
	if (htim->Instance != TIM2) return;

	/* Citeste ADC */
	V_panou = ((float)adc_buffer[0] * (3.3f / 4095.0f)) * V_DIVIDER_RATIO;
	I_panou = (((float)adc_buffer[1] * (3.3f / 4095.0f)) - I_OFFSET) / I_SENSITIVITY;
	if (I_panou < 0.0f) I_panou = 0.0f;
	P_panou = V_panou * I_panou;

	/* Protectii */
	static uint8_t error_count = 0;
	if (V_panou > V_MAX_CRITIC) {
		mppt_status_code = 1;
		pwm_value = PWM_MIN;
	} else if (I_panou > I_MAX_CRITIC) {
		if (++error_count > 5) {
			mppt_status_code = 2;
			pwm_value = PWM_MIN;
		}
	} else {
		mppt_status_code = 0;
		error_count = 0;

		/* P&O */
		if (P_panou < 0.1f) {
			pwm_value++;
		} else {
			float deltaP = P_panou - P_veche;
			float deltaV = V_panou - V_veche;
			if (deltaP > 0.1f) {
				if (deltaV >= 0.0f) pwm_value--; else pwm_value++;
			} else if (deltaP < -0.1f) {
				if (deltaV >= 0.0f) pwm_value++; else pwm_value--;
			}
		}
	}

	/* Limitare PWM */
	if (pwm_value < PWM_MIN) pwm_value = PWM_MIN;
	if (pwm_value > PWM_MAX) pwm_value = PWM_MAX;
	__HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, pwm_value);

	V_veche = V_panou;
	P_veche = P_panou;

	/* Seteaza flag pentru while(1) */
	tim2_flag_b = 1;
}

void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan_ptr) {
	CAN_RxHeaderTypeDef RxHeader;
	uint8_t RxData[8];

	if (HAL_CAN_GetRxMessage(hcan_ptr, CAN_RX_FIFO0, &RxHeader, RxData) == HAL_OK) {
		if (RxHeader.StdId == 0x630 && RxHeader.DLC == 4) {
			vcu_V_panou      = (float)RxData[0] / 10.0f;
			vcu_I_panou      = (float)RxData[1] / 10.0f;
			vcu_P_panou      = (float)RxData[2] * 2.0f;
			vcu_mppt_status  = RxData[3];
			data_ready       = 1;
		}
	}
}

