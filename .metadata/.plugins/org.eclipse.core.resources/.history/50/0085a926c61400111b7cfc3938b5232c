/**
 * @brief Trimite un mesaj CAN generic.
 *        Verifica mailbox liber inainte de trimitere.
 *        Nu apeleaza Error_Handler — esecul TX e loggat in telemetrie.
 */
static void CAN_TX(uint32_t StdId, uint8_t DLC, const uint8_t *Data)
{
    CAN_TxHeaderTypeDef hdr;
    uint32_t mailbox;

    hdr.StdId = StdId;
    hdr.IDE   = CAN_ID_STD;
    hdr.RTR   = CAN_RTR_DATA;
    hdr.DLC   = DLC;
    hdr.TransmitGlobalTime = DISABLE;

    if (HAL_CAN_GetTxMailboxesFreeLevel(&hcan) > 0) {
        HAL_CAN_AddTxMessage(&hcan, &hdr, Data, &mailbox);
    }
}

/**
 * @brief Trimite telemetria MPPT pe CAN_ID_MPPT_TX (0x630).
 *        Format 4 bytes:
 *          [0] = V_panou * 10  (ex: 245 = 24.5V)
 *          [1] = I_panou * 10  (ex:  85 =  8.5A)  — cu semn ignorat, min 0
 *          [2] = P_panou / 2   (ex: 100 = 200W)
 *          [3] = mppt_status   (0=OK, 1=OV, 2=OC, 3=STARTUP)
 */
static void CAN_SendMPPT(void)
{
    uint8_t v_enc = (uint8_t)(V_panou * 10.0f > 255.0f ? 255 : V_panou * 10.0f);
    uint8_t i_enc = (uint8_t)(I_panou < 0.0f ? 0 : (I_panou * 10.0f > 255.0f ? 255 : I_panou * 10.0f));
    uint8_t p_enc = (uint8_t)(P_panou / 2.0f > 255.0f ? 255 : P_panou / 2.0f);

    uint8_t data[4] = { v_enc, i_enc, p_enc, (uint8_t)mppt_status };
    TxHeader.StdId = CAN_ID_MPPT_TX;
    TxHeader.DLC   = 4;

    if (HAL_CAN_GetTxMailboxesFreeLevel(&hcan) > 0) {
        HAL_CAN_AddTxMessage(&hcan, &TxHeader, data, &TxMailbox);
    }
}

/**
 * @brief Broadcast periodic pe 0x100 catre alte noduri (ex. data logger, display).
 *        Format 8 bytes:
 *          [0-1] = V_panou * 100 (uint16 big-endian)
 *          [2-3] = I_panou * 100 (uint16 big-endian, semnat)
 *          [4-5] = P_panou * 10  (uint16 big-endian)
 *          [6]   = pwm_value * 100 / PWM_MAX  (duty cycle 0-100%)
 *          [7]   = mppt_status
 */
static void CAN_SendBroadcast(void)
{
    uint16_t v100  = (uint16_t)(V_panou * 100.0f);
    int16_t  i100  = (int16_t) (I_panou * 100.0f);
    uint16_t p10   = (uint16_t)(P_panou * 10.0f);
    uint8_t  duty  = (uint8_t) ((uint32_t)pwm_value * 100 / PWM_MAX);

    uint8_t data[8] = {
        (v100 >> 8) & 0xFF, v100 & 0xFF,
        (i100 >> 8) & 0xFF, i100 & 0xFF,
        (p10  >> 8) & 0xFF, p10  & 0xFF,
        duty,
        (uint8_t)mppt_status
    };
    CAN_TX(CAN_ID_BCAST, 8, data);
}

/**
 * @brief Algoritm Perturb & Observe.
 *        Apelat din ISR-ul TIM2 DUPA protectii.
 *        Modifica pwm_value cu ±1 pas.
 */
static void MPPT_RunPO(void)
{
    // Pornire progresiva: daca P e aproape 0 (panou deconectat/noapte), urca PWM incet
    if (P_panou < 0.5f) {
        if (pwm_value < PWM_DEFAULT) pwm_value++;
        return;
    }

    float deltaP = P_panou - P_veche;
    float deltaV = V_panou - V_veche;

    // P&O clasic: daca puterea a crescut, continua in aceeasi directie
    //             daca puterea a scazut, inverseaza directia
    if (deltaP > 0.1f) {
        // Putere a crescut — continua perturbatia
        if (deltaV >= 0.0f)
            pwm_value--;  // V a crescut => duty a scazut => continua sa scazi
        else
            pwm_value++;  // V a scazut  => duty a crescut => continua sa cresti
    } else if (deltaP < -0.1f) {
        // Putere a scazut — inverseaza perturbatia
        if (deltaV >= 0.0f)
            pwm_value++;
        else
            pwm_value--;
    }
    // |deltaP| <= 0.1f => suntem la MPP, nu perturbam
}

/**
 * @brief Verifica protectiile de tensiune si curent.
 *        Seteaza mppt_status si reseteaza PWM daca e cazul.
 * @return true daca exista fault activ (P&O nu trebuie rulat)
 */
static void MPPT_ApplyProtections(void)
{
    // --- Overvoltage ---
    if (V_panou >= V_MAX_CRITIC) {
        mppt_status = MPPT_OV_FAULT;
        pwm_value   = PWM_MIN;
        error_count = 0;
        return;
    }

    // Avertizare tensiune: reduce PWM agresiv
    if (V_panou >= V_WARN) {
        if (pwm_value > PWM_MIN) pwm_value -= 5;
        // Nu blocam complet, dar nu rulam P&O
        mppt_status = MPPT_OV_FAULT;
        return;
    }

    // --- Overcurrent cu filtru de stabilitate ---
    if (I_panou >= I_MAX_CRITIC) {
        error_count++;
        if (error_count >= ERROR_COUNT_LIMIT) {
            mppt_status = MPPT_OC_FAULT;
            pwm_value   = PWM_MIN;
        }
        // Nu resetam error_count — trebuie sa scada curentul ca sa iese din fault
        return;
    }

    // Avertizare curent: reduce PWM incet
    if (I_panou >= I_WARN) {
        if (pwm_value > PWM_MIN) pwm_value--;
        mppt_status = MPPT_OC_FAULT; // folosim acelasi cod de fault pentru simplitate
        error_count = 0;
        return;
    }

    // --- Totul OK ---
    mppt_status = MPPT_OK;
    error_count = 0;

    // Ruleaza P&O
    MPPT_RunPO();
}

/**
 * @brief Telemetrie UART detaliata.
 *        Tiparit in while(1) la fiecare flag TIM2.
 *        Format:
 *          [MPPT] V:24.50V | I:8.50A | P:208.25W | PWM:350(49%) | ST:OK
 *          [VCU ] Vb:48.20V | Ib:4.30A | Pb:207.26W | VCU_ST:0
 */
static void UART_PrintTelemetry(void)
{
    const char *status_str;
    switch (mppt_status) {
        case MPPT_OK:      status_str = "OK     "; break;
        case MPPT_OV_FAULT:status_str = "OV_FAULT"; break;
        case MPPT_OC_FAULT:status_str = "OC_FAULT"; break;
        case MPPT_STARTUP: status_str = "STARTUP"; break;
        default:           status_str = "UNKNOWN"; break;
    }

    uint8_t duty = (uint8_t)((uint32_t)pwm_value * 100 / PWM_MAX);

    int len = snprintf(uart_buf, sizeof(uart_buf),
        "[MPPT] V:%5.2fV | I:%5.2fA | P:%6.2fW | PWM:%3d(%2d%%) | ST:%s | CAN:%s\r\n",
        V_panou, I_panou, P_panou, pwm_value, duty, status_str,
        can_ok ? "OK" : "OFF");
    HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, len, 10);

    // Date de la VCU (daca exista)
    if (vcu_data_ready) {
        len = snprintf(uart_buf, sizeof(uart_buf),
            "[VCU ] Vb:%5.2fV | Ib:%5.2fA | Pb:%6.2fW | VCU_ST:%d\r\n",
            vcu_V_bat, vcu_I_bat, vcu_P_bat, vcu_status);
        HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, len, 10);
    }
}

