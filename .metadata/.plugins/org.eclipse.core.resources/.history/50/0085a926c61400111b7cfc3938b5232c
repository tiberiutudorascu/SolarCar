  /* USER CODE BEGIN 2 */

    // --- Configurare filtru CAN ---
    // Accepta toate ID-urile (masca 0x000).
    // Diferentierea ID-urilor se face in HAL_CAN_RxFifo0MsgPendingCallback.
    CAN_FilterTypeDef sFilterConfig;
    sFilterConfig.FilterBank           = 0;
    sFilterConfig.FilterMode           = CAN_FILTERMODE_IDMASK;
    sFilterConfig.FilterScale          = CAN_FILTERSCALE_32BIT;
    sFilterConfig.FilterIdHigh         = 0x0000;
    sFilterConfig.FilterIdLow          = 0x0000;
    sFilterConfig.FilterMaskIdHigh     = 0x0000;  // 0 = accepta orice bit
    sFilterConfig.FilterMaskIdLow      = 0x0000;
    sFilterConfig.FilterFIFOAssignment = CAN_RX_FIFO0;
    sFilterConfig.FilterActivation     = ENABLE;
    if (HAL_CAN_ConfigFilter(&hcan, &sFilterConfig) != HAL_OK) {
        Error_Handler();
    }

    // --- Pornire periferice in ordine corecta ---
    HAL_ADCEx_Calibration_Start(&hadc1);
    HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, 2);

    // CAN pornit fara Error_Handler — daca bus-ul nu e conectat (fara VCU, fara 120ohm),
    // HAL_CAN_Start returneaza eroare dar codul continua. UART ramane functional.
    can_ok = 1;  // Folosim variabila globala
    if (HAL_CAN_Start(&hcan) != HAL_OK) {
        can_ok = 0;
    }
    if (can_ok && HAL_CAN_ActivateNotification(&hcan, CAN_IT_RX_FIFO0_MSG_PENDING) != HAL_OK) {
        can_ok = 0;
    }

    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, PWM_DEFAULT);

    HAL_TIM_Base_Start_IT(&htim2);

    // --- Pregatire header CAN TX ---
    TxHeader.StdId              = CAN_ID_MPPT_TX;
    TxHeader.IDE                = CAN_ID_STD;
    TxHeader.RTR                = CAN_RTR_DATA;
    TxHeader.DLC                = 4;
    TxHeader.TransmitGlobalTime = DISABLE;

    // Mesaj de start pe UART — apare indiferent daca CAN e conectat sau nu
    int blen = snprintf(uart_buf, sizeof(uart_buf),
        "\r\n=== MPPT BOOT | CAN: %s ===\r\n",
        can_ok ? "OK" : "EROARE-bus neconectat");
    HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, blen, 50);
    mppt_status = MPPT_STARTUP;

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
    while (1)
    {
        // Asteapta flag-ul setat de ISR-ul TIM2
        if (tim2_flag) {

            // Consuma flag-ul inainte de orice operatie (previne pierderi)
            tim2_flag = false;

            // Toggle LED de stare — o data per ciclu TIM2 (~112ms)
            // LED-ul bluepill (PC13) e activ-LOW: se aprinde cand e RESET
            HAL_GPIO_TogglePin(LED_STARE_GPIO_Port, LED_STARE_Pin);

            // Afiseaza telemetria pe UART
            UART_PrintTelemetry();

            // Daca au sosit date noi de la VCU, reseteaza flag-ul
            if (vcu_data_ready) {
                vcu_data_ready = 0;
            }
        }
    }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  /* USER CODE END 3 */
}

