/**
 * @brief Callback TIM2 — inima sistemului MPPT.
 *        Ruleaza la ~112ms.
 *        Actiuni:
 *          1. Citeste ADC (DMA a actualizat adc_buffer)
 *          2. Aplica protectii
 *          3. Ruleaza P&O (daca nu e fault)
 *          4. Aplica PWM
 *          5. Trimite telemetria CAN
 *          6. Seteaza flag pentru while(1)
 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance != TIM2) return;

    // --- 1. Conversie ADC -> valori fizice ---
    V_panou = ADC_TO_VOLT(adc_buffer[0]) * V_DIVIDER_RATIO;
    I_panou = (ADC_TO_VOLT(adc_buffer[1]) - I_OFFSET) / I_SENSITIVITY;
    if (I_panou < 0.0f) I_panou = 0.0f;  // Curent negativ = zgomot, ignorat
    P_panou = V_panou * I_panou;

    // --- 2 + 3. Protectii + P&O ---
    MPPT_ApplyProtections();

    // --- 4. Limitare si aplicare PWM ---
    if (pwm_value < PWM_MIN) pwm_value = PWM_MIN;
    if (pwm_value > PWM_MAX) pwm_value = PWM_MAX;
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, pwm_value);

    // --- 5. Salveaza istoricul P&O ---
    V_veche = V_panou;
    P_veche = P_panou;

    // --- 6. Telemetrie CAN ---
    static uint8_t telem_count = 0;
    if (++telem_count >= TELEM_TICKS) {
        if (can_ok) {           // Trimite CAN doar daca bus-ul e functional
            CAN_SendMPPT();
            CAN_SendBroadcast();
        }
        telem_count = 0;
    }

    // --- 7. Seteaza flag pentru while(1) ---
    tim2_flag = true;
}

/**
 * @brief Callback CAN RX FIFO0 — proceses mesaje receptionate.
 *
 *        ID 0x630, DLC=4: date de la VCU
 *          [0] = V_bat * 10
 *          [1] = I_bat * 10
 *          [2] = P_bat / 2
 *          [3] = status VCU
 *
 *        Alte ID-uri sunt ignorate (filtrul accept tot).
 */
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan_ptr)
{
    CAN_RxHeaderTypeDef RxHeader;
    uint8_t RxData[8];

    if (HAL_CAN_GetRxMessage(hcan_ptr, CAN_RX_FIFO0, &RxHeader, RxData) != HAL_OK) return;

    if (RxHeader.StdId == CAN_ID_VCU_RX && RxHeader.DLC == 4) {
        // Decode date VCU
        vcu_V_bat  = (float)RxData[0] / 10.0f;
        vcu_I_bat  = (float)RxData[1] / 10.0f;
        vcu_P_bat  = (float)RxData[2] * 2.0f;
        vcu_status = RxData[3];
        vcu_data_ready = 1;
    }
    // Adauga aici alte ID-uri daca ai mai multe noduri pe bus
}

